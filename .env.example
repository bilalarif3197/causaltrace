# Copy to backend/.env (or export in your shell) to enable live analysis.
# Without a key, CausalTrace runs in mock mode: the full pipeline executes
# against recorded fixtures, but only the three built-in example cases can be
# analyzed.

OPENAI_API_KEY=

# Structured outputs require a model that supports strict JSON schema.
# OPENAI_MODEL=gpt-4o-2024-08-06

# Comma-separated origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000

# Frontend -> backend URL (set in frontend/.env.local if not the default).
# NEXT_PUBLIC_API_URL=http://localhost:8000
