# Copy to backend/.env to enable live analysis.
#
# Without a key, CausalTrace runs in mock mode: the full pipeline executes
# against recorded fixtures, but only the three built-in example cases can be
# analyzed. A custom narrative returns HTTP 422 explaining why.

# ---------------------------------------------------------------------------
# Option 1 -- OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-2024-08-06

# ---------------------------------------------------------------------------
# Option 2 -- any OpenAI-compatible endpoint
#
# Set OPENAI_BASE_URL and put that provider's key in OPENAI_API_KEY. The client
# negotiates structured-output support downward on first use (strict JSON
# schema -> json_object -> schema-in-prompt) and tells you in the UI when the
# provider cannot enforce the schema.
#
# DeepSeek:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-flash          # or deepseek-v4-pro
#   OPENAI_MAX_TOKENS=8192
#   OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}
#   NOTE: DeepSeek enables thinking mode by default, and in thinking mode it
#   SILENTLY IGNORES temperature -- determinism is lost with no error raised.
#   Disabling thinking makes temperature=0 take effect and cuts cost.
#
# Groq (free tier):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Local Ollama (no key needed; any placeholder works):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.1
#   OPENAI_API_KEY=ollama
#
# Check your config with one cheap call:  cd backend && python preflight.py
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=

# auto (default) | strict | json_object | prompt
# Force a mode only if auto-negotiation misbehaves.
# OPENAI_JSON_MODE=auto

# Assessment work wants determinism. Dropped automatically if the model
# rejects an explicit temperature.
# OPENAI_TEMPERATURE=0

# Guards against long structured output being truncated mid-string. The
# extraction stage is the one at risk.
# OPENAI_MAX_TOKENS=8192

# JSON object merged into every request, for provider-specific parameters.
# Keeps vendor quirks in config rather than in the client code.
# OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Any loopback origin on any port is allowed by default, so the dev server, a
# browser preview proxy and an SSH tunnel all work without configuration.
# Add non-loopback origins here (comma separated) when deploying.
# CORS_ORIGINS=https://causaltrace.example.com
#
# Replaces the default loopback pattern entirely. Set to something
# unmatchable to lock CORS down to CORS_ORIGINS only.
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$

# NEXT_PUBLIC_API_URL=http://localhost:8000   (set in frontend/.env.local)
